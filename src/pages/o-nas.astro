---
import Layout from '../layouts/Layout.astro';
import SideLeaves from '../components/SideLeaves.astro';
import partnersData from '../data/partners.json';

const partners = (partnersData as any).partners as any[];

const team = [
  {
    name: 'Justyna Żak',
    role: 'Co-founder & Co-CEO',
    photo: 'justyna-zak.png',
    bio: 'Twórczyni internetowa promująca weganizm od ponad 8 lat. Wierna swoim zasadom jak nikt inny. W Plantutti odpowiada za współpracę z Partnerami i tworzenie treści na stronę i Instagram!',
    links: [
      { label: 'YouTube', url: 'https://www.youtube.com/user/Juszes' },
      { label: 'Instagram', url: 'https://www.instagram.com/juszes/?hl=pl' },
      { label: 'TikTok', url: 'https://tiktok.com/@juszesek' },
    ],
  },
  {
    name: 'Zuzanna Mazurek',
    role: 'Co-founder & Co-CEO',
    photo: 'zuzanna-mazurek.png',
    bio: 'Ekspertka w dziedzinie zrównoważonego rozwoju i zarządzania produktem cyfrowym. Od niedawna też mama Benka. Zuzia jest bardziej „LinkedIn type of person”. W Plantutti odpowiada za naszą stronę i strategię długoterminową.',
    links: [
      { label: 'LinkedIn', url: 'https://www.linkedin.com/in/zuzannamazurek/' },
      { label: 'Instagram', url: 'https://www.instagram.com/zuzannamazurek_official/?hl=en' },
    ],
  },
];

const values = [
  { title: 'Wierzymy w roślinny świat', text: 'W Plantutti promujemy roślinny styl życia, wierząc w jego pozytywny wpływ na zdrowie ludzi oraz środowisko naturalne.' },
  { title: 'Walczymy o niższe ceny', text: 'Uważamy, że roślinne produkty mogą być dostępne dla każdego, bez względu na zasoby finansowe.' },
  { title: 'Wspieramy przywództwo kobiet', text: 'Plantutti to firma założona przez dwie kobiety i naszym celem jest inspirowanie innych kobiet do spełniania swoich biznesowych marzeń.' },
  { title: 'Działamy na rzecz lepszego jutra', text: 'Jesteśmy zaangażowane w promowanie zrównoważonych rozwiązań poprzez edukację i różne formy aktywizmu.' },
];
---

<Layout
  title="O nas — Plantutti"
  description="Poznaj historię Plantutti — serwisu promującego roślinne alternatywy, oszczędzanie i dostęp do promocji dla każdego."
>
  <!-- ===== O nas + Nasza historia (białe tło, dekoracje po bokach) ===== -->
  <section class="band band-white">
    <div class="container narrow">
      <h1 class="page-title">O nas</h1>

      <div class="story-row">
        <div class="decor decor-star" aria-hidden="true">
          <svg viewBox="0 0 200 200">
            <circle cx="100" cy="100" r="100" fill="var(--color-cream)" />
            <path d="M100 28 C104 66 134 96 172 100 C134 104 104 134 100 172 C96 134 66 104 28 100 C66 96 96 66 100 28 Z" fill="#fff" />
          </svg>
        </div>
        <div class="story-text">
          <h2>Nasza historia</h2>
          <p>Niby spotkałyśmy się na ploteczki przy kawie, ale temat rozmowy przejęła inflacja w Polsce. Zaczęłyśmy porównywać, w którym supermarkecie można najtaniej kupić napój roślinny i tofu. Okazało się, że w gazetkach promocyjnych i aplikacjach supermarketów najczęściej objęte rabatami są przetwory mięsne i sery. Zrodziło to pytanie — czy takie są preferencje klientów? A co z ludźmi, którzy wykluczają mięso z diety dla dobra zwierząt i planety? Czy roślinożercy są skazani na brak promocji?</p>
        </div>
      </div>

      <div class="story-row story-row-reverse">
        <div class="story-text">
          <p>Dziś razem tworzymy miejsce, gdzie znajdziecie trzy rodzaje promocji: na sklepowych półkach, w sklepach internetowych i stałe rabaty od naszych partnerów.</p>
          <p>Plantutti to serwis promujący roślinne alternatywy, troskę o planetę oraz… oszczędzanie. Uważamy, że osoby z takimi wartościami powinny mieć równy dostęp do promocji, tak jak ci, którzy żyją „normalnie”. Postanowiłyśmy zmienić świat na lepsze, dając Wam dostęp do roślinnych promocji. A jeśli nie jesteś weganinem, również spoko — zapraszamy!</p>
        </div>
        <div class="decor decor-flower" aria-hidden="true">
          <svg viewBox="0 0 200 200">
            <path d="M100 4 C128 44 128 76 100 100 C72 76 72 44 100 4 Z" fill="var(--color-cream)" />
            <path d="M196 100 C156 128 124 128 100 100 C124 72 156 72 196 100 Z" fill="var(--color-cream)" />
            <path d="M100 196 C72 156 72 124 100 100 C128 124 128 156 100 196 Z" fill="var(--color-cream)" />
            <path d="M4 100 C44 72 76 72 100 100 C76 128 44 128 4 100 Z" fill="var(--color-cream)" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Zespół Plantutti (beżowy pas, listki w rogach, karty ze zdjęciami nachodzącymi) ===== -->
  <section class="band band-cream team-band">
    <SideLeaves class="leaves leaves-left" flip />
    <SideLeaves class="leaves leaves-right" />
    <div class="container narrow">
      <h2 class="center">Zespół Plantutti</h2>
      <div class="team-grid">
        {team.map((person) => (
          <div class="person-card">
            <img class="person-photo" src={`/images/team/${person.photo}`} alt={person.name} loading="lazy" />
            <p class="person-name">{person.name}</p>
            <p class="person-role">{person.role}</p>
            <div class="person-links">
              {person.links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
              ))}
            </div>
            <p class="person-bio">{person.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Nasze wartości (białe tło, wielkie blade cyfry) ===== -->
  <section class="band band-white">
    <div class="container narrow">
      <h2>Nasze wartości</h2>
      <p class="lead">Te wartości stanowią fundament naszej firmy i napędzają nas do dostarczania wyjątkowych promocji, wspierając jednocześnie globalny ruch na rzecz weganizmu.</p>
      <div class="values-grid">
        {values.map((v, i) => (
          <div class="value-item">
            <span class="value-number" aria-hidden="true">{i + 1}.</span>
            <div>
              <p class="value-title">{v.title}</p>
              <p class="value-text">{v.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Cytat (beżowy pas na całą szerokość) ===== -->
  <section class="band band-cream quote-band">
    <p class="quote">Nie godzimy się z gazetkami promocyjnymi dyskryminującymi roślinożerców!</p>
  </section>

  <!-- ===== Zaufali nam ===== -->
  <section class="band band-white">
    <div class="container narrow">
      <h2 class="center">Zaufali nam</h2>
      <p class="lead center">Korzystanie z Plantutti jest darmowe i chcemy, aby takie pozostało. Portal utrzymuje się dzięki współpracy z partnerami, którzy udostępnili dla nas kody afiliacyjne.</p>
      <div class="logos-grid">
        {partners.map((p) => (
          <div class="logo-tile">
            <img src={`/${p.logo}`} alt={`Logo ${p.name}`} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .band { padding: 64px 0; position: relative; overflow: hidden; }
  .band-white { background: #fdfdfd; }
  .band-cream { background: var(--color-cream); }
  .narrow { max-width: 1000px; padding-left: 24px; padding-right: 24px; }

  h1.page-title {
    font-family: var(--font-logo);
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3rem);
    margin: 0 0 36px;
  }
  h2 {
    font-family: var(--font-logo);
    font-weight: 400;
    font-size: clamp(1.6rem, 3.4vw, 2.1rem);
    margin: 0 0 20px;
  }
  .center { text-align: center; }
  .lead { color: var(--color-text-muted); line-height: 1.7; max-width: 640px; margin: 0 0 40px; }
  .lead.center { margin-left: auto; margin-right: auto; }

  /* --- Nasza historia --- */
  .story-row {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: 56px;
    align-items: center;
    margin-bottom: 40px;
  }
  .story-row-reverse { grid-template-columns: 1fr 0.8fr; }
  .story-text p { line-height: 1.8; margin: 0 0 1.1em; }
  .decor svg { width: 100%; max-width: 280px; height: auto; display: block; margin: 0 auto; }

  /* --- Zespół --- */
  .team-band { padding-top: 72px; padding-bottom: 88px; }
  .leaves { position: absolute; top: 40px; width: 70px; height: auto; color: #fdfdfd; }
  .leaves-left { left: 0; }
  .leaves-right { right: 0; }
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
    max-width: 640px;
    margin: 72px auto 0;
  }
  .person-card {
    background: #fdfdfd;
    border-radius: var(--radius-xl);
    padding: 0 24px 28px;
    text-align: center;
  }
  .person-photo {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: -56px auto 14px;
    border: 7px solid var(--color-cream);
    background: var(--color-light-green);
  }
  .person-name { font-family: var(--font-logo); font-size: 1.1rem; margin: 0; color: var(--color-primary); }
  .person-role { font-size: 0.82rem; color: var(--color-text-muted); margin: 2px 0 10px; }
  .person-links { display: flex; gap: 14px; justify-content: center; margin-bottom: 14px; flex-wrap: wrap; }
  .person-links a { font-size: 0.8rem; font-weight: 700; color: var(--color-primary); text-decoration: none; }
  .person-links a:hover { text-decoration: underline; }
  .person-bio { font-size: 0.85rem; line-height: 1.65; margin: 0; }

  /* --- Wartości --- */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 48px;
  }
  .value-item { display: flex; gap: 16px; align-items: flex-start; }
  .value-number {
    font-family: var(--font-logo);
    font-size: clamp(3.4rem, 8vw, 5.5rem);
    line-height: 0.9;
    color: var(--color-cream);
    flex-shrink: 0;
    min-width: 1.1em;
  }
  .value-title { font-family: var(--font-logo); font-size: 1rem; margin: 6px 0 8px; color: var(--color-primary); }
  .value-text { font-size: 0.88rem; font-weight: 700; line-height: 1.6; margin: 0; }

  /* --- Cytat --- */
  .quote-band { padding: 72px 24px; }
  .quote {
    font-family: var(--font-logo);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    line-height: 1.4;
    color: var(--color-primary);
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  /* --- Zaufali nam --- */
  .logos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 16px;
  }
  .logo-tile {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }
  .logo-tile img { max-height: 52px; max-width: 100%; width: auto; object-fit: contain; }

  @media (max-width: 760px) {
    .story-row, .story-row-reverse { grid-template-columns: 1fr; gap: 24px; }
    .story-row-reverse .decor { order: -1; }
    .decor svg { max-width: 180px; }
    .values-grid { grid-template-columns: 1fr; }
    .leaves { width: 40px; }
  }
</style>

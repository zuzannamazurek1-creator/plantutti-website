---
import Header from '../components/Header.astro';
import AnimatedBanner from '../components/AnimatedBanner.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title,
  description = 'Szukasz promocji na roślinne, wegańskie i zrównoważone produkty? Wejdź na Plantutti i oszczędzaj korzystając z rabatów na produkty zgodne z Twoimi wartościami.',
  ogImage = '/images/logo/plantutti-logo.svg',
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, 'https://www.plantutti.pl').toString();
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/images/logo/plantutti-znak.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta name="google-site-verification" content="B4wwXuyglceynTkArGx5CAdHeUXB-MrvIYW_jXOhoZ8" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Header />
    <AnimatedBanner />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>

---
import LeafMark from './LeafMark.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <LeafMark size={32} color="var(--color-dark-green)" />

    <nav class="footer-links">
      <a href="/polityka-prywatnosci">Polityka prywatności</a>
      <a href="/regulamin">Regulamin</a>
    </nav>

    <p class="footer-copy">&copy; {year} Plantutti</p>

    <a href="https://www.instagram.com/plantutti_pl/" class="footer-social" target="_blank" rel="noopener">
      Instagram
    </a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    padding: 32px 0;
    margin-top: 64px;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px;
    text-align: center;
  }
  .footer-links {
    display: flex;
    gap: 20px;
  }
  .footer-links a,
  .footer-social {
    text-decoration: none;
    color: var(--color-dark-green);
    font-weight: 700;
  }
  .footer-links a:hover,
  .footer-social:hover { color: var(--color-accent-dark); }
  .footer-copy { margin: 0; color: var(--color-dark-green); font-weight: 600; }
</style>
